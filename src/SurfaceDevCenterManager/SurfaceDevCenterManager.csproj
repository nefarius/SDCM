<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SurfaceDevCenterManager</RootNamespace>
    <AssemblyName>sdcm</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sdcm</ToolCommandName>
    <PackageId>Nefarius.Tools.SDCM</PackageId>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package / assembly metadata (replaces AssemblyInfo.cs) -->
    <Product>Surface Dev Center Manager</Product>
    <Description>Command-line tool to automate Microsoft Hardware Dev Center (Partner Center) driver and firmware submissions. A modernized fork of microsoft/SDCM.</Description>
    <PackageTags>hardware;dev-center;partner-center;driver;whql;attestation;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Devices.HardwareDevCenterManager" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>
    <Content Include="authconfig.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

</Project>
